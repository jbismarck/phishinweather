<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Phishinweather — Print Poster</title>
  <link rel="stylesheet" href="styles/main.css?v=<%= Date.now() %>" />
  <style>
    html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: #001040; }
  </style>
</head>
<body>

<div id="poster-page">
  <div class="poster-eyebrow">OFFICIAL TOUR WEATHER CHANNEL</div>

  <div class="poster-title">PHISHIN</div>
  <div class="poster-tld">WEATHER.COM</div>

  <hr class="poster-rule" />

  <div class="poster-tagline">YOUR PHISH TOUR WEATHER CHANNEL</div>

  <div class="poster-qr-wrap">
    <div class="poster-qr-placeholder">QR CODE</div>
  </div>

  <div class="poster-url">phishinweather.com</div>

  <div class="poster-est">EST. 2026</div>
</div>

</body>
</html>
