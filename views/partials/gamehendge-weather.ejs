      <div class="gw-temps">
        <div class="gw-block lo">
          <div class="gw-label">Lo</div>
          <div class="gw-value">46</div>
        </div>
        <div class="gw-block hi">
          <div class="gw-label">Hi</div>
          <div class="gw-value">72</div>
        </div>
      </div>
    </div>

    <div class="gw-panel">
      <div class="gw-location">WILSON'S KEEP</div>
      <div class="gw-icon"><img src="images/icons/current-conditions/Scattered-Thunderstorms-Day.gif" /></div>
      <div class="gw-condition">SEVERE EVIL</div>
      <div class="gw-temps">
        <div class="gw-block lo">
          <div class="gw-label">Lo</div>
          <div class="gw-value">66</div>
        </div>
        <div class="gw-block hi">
          <div class="gw-label">Hi</div>
          <div class="gw-value">99</div>
        </div>
      </div>
    </div>

  </div>

</div>
<%- include('scroll.ejs') %>
