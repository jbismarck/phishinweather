<%- include('header.ejs', {titleDual: {top: 'PHISH', bottom: 'SUMMER TOUR'}, hasTime: true}) %>
<div class="main has-scroll phish-tour">

  <!-- Show Info Card -->
  <div class="card card-info">
    <div class="info-header">
      <div class="info-header-top">
        <span class="show-venue"></span>
        <span class="info-dot">•</span>
        <span class="show-city"></span>
      </div>
      <div class="info-header-bot">
        <span class="show-date"></span>
        <span class="info-dot">•</span>
        <span class="show-countdown"></span>
        <span class="show-counter"></span>
      </div>
    </div>
    <div class="policy-panels">
      <div class="policy-panel">
        <div class="pp-label">BOTTLES</div>
        <div class="pp-value policy-bottles"></div>
      </div>
      <div class="policy-panel">
        <div class="pp-label">TUBES</div>
        <div class="pp-value policy-tubes"></div>
      </div>
      <div class="policy-panel">
        <div class="pp-label">WATER<br>STATION</div>
        <div class="pp-value policy-water-station"></div>
      </div>
    </div>
  </div>

  <!-- Forecast Card -->
  <div class="card card-forecast">
    <div class="forecast-panels">
      <div class="forecast-panel template">
        <div class="fp-date"></div>
        <div class="fp-icon"><img src="" /></div>
        <div class="fp-condition"></div>
        <div class="fp-temperatures">
          <div class="fp-temp-block lo">
            <div class="fp-label">Lo</div>
            <div class="fp-value fp-lo"></div>
          </div>
          <div class="fp-temp-block hi">
            <div class="fp-label">Hi</div>
            <div class="fp-value fp-hi"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="no-forecast" style="display:none">FORECAST UNAVAILABLE</div>
  </div>

  <!-- Eats Card -->
  <div class="card card-eats">
    <div class="eats-header">WHERE TO EAT  <span class="eats-venue"></span></div>
    <div class="eats-list">
      <div class="eat-item template">
        <div class="eat-name-row">
          <span class="eat-name"></span>
          <span class="eat-type"></span>
        </div>
        <div class="eat-note"></div>
      </div>
    </div>
  </div>

  <!-- Shakedown Card -->
  <div class="card card-shakedown">
    <div class="shakedown-title">SHAKEDOWN ST.</div>
    <div class="sd-venue"></div>
    <div class="sd-row">
      <span class="sd-label">LOCATION</span>
      <span class="sd-location"></span>
    </div>
    <div class="sd-row">
      <span class="sd-label">PARKING</span>
      <span class="sd-parking"></span>
    </div>
    <div class="sd-tip-wrap">
      <div class="sd-tip"></div>
    </div>
  </div>

</div>
<%- include('scroll.ejs') %>
